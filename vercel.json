{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/novy-web", "destination": "/", "permanent": true },
    { "source": "/novy-web/", "destination": "/", "permanent": true },
    { "source": "/novy-web/:path*", "destination": "/", "permanent": true },
    { "source": "/kartogram", "destination": "/kartogram/", "permanent": true },
    { "source": "/mapy-api", "destination": "/mapy-api/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/kartogram/", "destination": "https://acart-8-kartogram.vercel.app/kartogram/" },
    { "source": "/kartogram/:path+", "destination": "https://acart-8-kartogram.vercel.app/kartogram/:path+" },
    { "source": "/mapy-api/", "destination": "https://acart-8-kartogram.vercel.app/mapy-api/" },
    { "source": "/bp/:path*", "destination": "/bp/index.html" },
    { "source": "/nasa", "destination": "/nasa/index.html" },
    { "source": "/nasa/", "destination": "/nasa/index.html" },
    { "source": "/opalena", "destination": "/opalena/index.html" },
    { "source": "/opalena/", "destination": "/opalena/index.html" }
  ]
}
